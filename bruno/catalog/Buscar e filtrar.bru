meta {
  name: Buscar e filtrar
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/products?category=guitars&condition=new&brand=Fender&sort=price-asc&page=1&perPage=24
  body: none
  auth: none
}

params:query {
  category: guitars
  condition: new
  brand: Fender
  sort: price-asc
  page: 1
  perPage: 24
  ~q: stratocaster
  ~freeShipping: true
  ~minPrice: 20000
  ~maxPrice: 400000
}

assert {
  res.status: eq 200
  res.body.total: eq 1
}

docs {
  As contagens em `facets` sao calculadas contra os *outros* filtros ativos: com `brand=Fender` selecionado, o facet de marca ainda mostra Squier, Tagima e Epiphone. Os parametros com `~` estao desativados — ligue no Bruno para explorar.
}
