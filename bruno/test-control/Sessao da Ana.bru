meta {
  name: Sessao da Ana
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/test/session
  body: json
  auth: none
}

body:json {
  {
    "email": "ana.souza@timbre.test"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}

docs {
  Pula o formulario de login e guarda o token em `token`. Conta limpa: sem pedidos, sem endereco salvo.
}
