meta {
  name: Login com senha errada
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ana.souza@timbre.test",
    "password": "Errada@1234"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq INVALID_CREDENTIALS
}

docs {
  Corpo identico ao de um e-mail inexistente: sem enumeracao de usuarios.
}
