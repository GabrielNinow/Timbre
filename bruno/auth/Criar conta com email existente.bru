meta {
  name: Criar conta com email existente
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Outra Ana",
    "email": "ana.souza@timbre.test",
    "password": "Teste@1234"
  }
}

assert {
  res.status: eq 422
  res.body.error.code: eq EMAIL_TAKEN
}
