meta {
  name: Criar conta
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Carla Dias",
    "email": "carla.dias@timbre.test",
    "password": "Teste@1234"
  }
}

assert {
  res.status: eq 201
  res.body.user.id: eq u-06
}

docs {
  Ids e tokens vem da sequencia de fixture. Rodar duas vezes sem reset devolve 422 EMAIL_TAKEN.
}
