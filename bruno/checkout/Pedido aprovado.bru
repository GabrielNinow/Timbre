meta {
  name: Pedido aprovado
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "shipping": {
      "recipient": "Ana Souza",
      "cep": "89010-000",
      "street": "Rua XV de Novembro",
      "number": "1400",
      "complement": "",
      "district": "Centro",
      "city": "Blumenau",
      "state": "SC"
    },
    "payment": {
      "method": "card",
      "card": {
        "number": "4111 1111 1111 1111",
        "holder": "ANA SOUZA",
        "expiry": "12/30",
        "cvv": "123"
      }
    },
    "selectedShippingId": "standard"
  }
}

assert {
  res.status: eq 201
  res.body.number: eq TMB-100241
  res.body.status: eq paid
}

script:post-response {
  bru.setEnvVar("orderId", res.body.id);
}

docs {
  O primeiro pedido de uma loja recem-resetada e sempre TMB-100241. Baixa o estoque e esvazia o carrinho.
}
