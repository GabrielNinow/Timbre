{
  "name": "timbre",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api:dev": "npm run dev --workspace @timbre/api",
    "api:start": "npm run start --workspace @timbre/api",
    "app:dev": "npm run dev --workspace @timbre/app",
    "app:build": "npm run build --workspace @timbre/app",
    "app:preview": "npm run preview --workspace @timbre/app",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
